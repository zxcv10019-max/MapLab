      "methodology": "公开汇总值；统计口径应以各省统计公报为准，本原型未逐省复核。",
      "verificationStatus": "待逐省与官方统计公报复核"
    },
    "density": {
      "label": "人口密度",
      "unit": "人/km²",
      "sourceName": "本软件基于GeoJSON几何面积推算",
      "sourceUrl": "https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json",
      "methodology": "年末人口（万人）×10,000÷多边形球面面积（km²）；几何面积为估算，非官方公布人口密度。",
      "verificationStatus": "本软件依据人口和简化边界几何推算，非官方发布指标"
    }
  },
